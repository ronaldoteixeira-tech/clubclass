    {
      "parameters": {
        "jsCode": "let raw = $input.first().json.body || $input.first().json;\n\n// Garante parse caso venha como string\nif (typeof raw === 'string') {\n  try {\n    raw = JSON.parse(raw);\n  } catch (e) {\n    raw = {};\n  }\n}\n\n// 1. Limpeza e Formatação de CNPJ\nlet cnpj = (raw.cnpj || '').toString().trim();\nconst cnpjDigits = cnpj.replace(/\\D/g, '');\nif (cnpjDigits.length === 14) {\n  cnpj = cnpjDigits.replace(/^(\\d{2})(\\d{3})(\\d{3})(\\d{4})(\\d{2})$/, '$1.$2.$3/$4-$5');\n}\n\n// 2. Limpeza e Formatação de Telefone\nlet telefone = (raw.telefone || '').toString().trim();\nconst phoneDigits = telefone.replace(/\\D/g, '');\nif (phoneDigits.length === 11) {\n  telefone = phoneDigits.replace(/^(\\d{2})(\\d{5})(\\d{4})$/, '($1) $2-$3');\n} else if (phoneDigits.length === 10) {\n  telefone = phoneDigits.replace(/^(\\d{2})(\\d{4})(\\d{4})$/, '($1) $2-$3');\n}\n\n// 3. Data e Hora no fuso de Brasília\nconst now = new Date();\nconst dataHora = new Intl.DateTimeFormat('pt-BR', {\n  timeZone: 'America/Sao_Paulo',\n  dateStyle: 'short',\n  timeStyle: 'medium'\n}).format(now);\n\nreturn [{\n  json: {\n    dataHora: dataHora,\n    razaoSocial: (raw.razao_social || '').toString().trim(),\n    cnpj: cnpj,\n    nomeResponsavel: (raw.nome_responsavel || '').toString().trim(),\n    telefone: telefone,\n    evento: (raw.evento || 'clubclass-lancamento-2026-10-28').toString().trim(),\n    status: 'Confirmado'\n  }\n}];"
      },
